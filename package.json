{
	"name": "jsonpath-js",
	"version": "0.3.1",
	"description": "An implementation of JSONPath",
	"author": "ashphy <ne.vivam.si.abis@gmail.com>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ashphy/jsonpath-js.git"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"require": "./dist/index.js",
			"import": "./dist/index.mjs"
		}
	},
	"main": "dist/index.js",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"engines": {
		"node": ">=20"
	},
	"files": [
		"dist",
		"package.json",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"jsonpath",
		"json"
	],
	"scripts": {
		"build": "tsup",
		"build:parser": "peggy --extra-options-file src/grammar/config.js",
		"lint": "biome check",
		"typecheck": "tsc --noEmit -p tsconfig.esm.json",
		"test": "vitest"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@types/jest": "^30.0.0",
		"@types/node": "26.6.6",
		"lefthook": "^2.2.2",
		"npm-run-all": "^4.1.5",
		"peggy": "5.1.0",
		"tsup": "^8.5.1",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vitest": "^4.1.12"
	}
}
